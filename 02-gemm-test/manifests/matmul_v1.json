{
  "schema_version": 1,
  "abi": "matmul(A,B,**options) -> C",
  "config": {
    "compute_capability": "sm120",
    "input_dtype": "float16",
    "options": {
      "variant": "matmul_3",
      "block_m": 16,
      "block_n": 16,
      "block_k": 16,
      "threads": 64,
      "num_stages": 1
    }
  },
  "performance_policy": {
    "timing": {
      "method": "triton.testing.do_bench",
      "warmup_ms": 25,
      "rep_ms": 100,
      "return_mode": "median",
      "clear_l2": true
    },
    "flops": "2*M*N*K",
    "result": "duration_ms, TFLOP/s, and percent_of_cuBLAS"
  },
  "cases": [
    {"id": "scalar-zero", "mode": "correctness", "M": 1, "N": 1, "K": 1, "pattern": "zeros", "seed": 1},
    {"id": "small-rectangle", "mode": "correctness", "M": 7, "N": 19, "K": 13, "pattern": "ramp", "seed": 2},
    {"id": "three-axis-tail", "mode": "correctness", "M": 37, "N": 53, "K": 29, "pattern": "random", "seed": 3},
    {"id": "large-tail", "mode": "correctness", "M": 129, "N": 257, "K": 65, "pattern": "random", "seed": 4},
    {"id": "skinny-m", "mode": "correctness", "M": 1, "N": 127, "K": 31, "pattern": "random", "seed": 5},
    {"id": "skinny-n", "mode": "correctness", "M": 113, "N": 1, "K": 17, "pattern": "random", "seed": 6},
    {"id": "square-4096", "mode": "performance", "M": 4096, "N": 4096, "K": 4096, "pattern": "random", "seed": 10}
  ]
